{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemTrait",
  "description": "Compositional boolean about a system under review. Traits decide whether a QuestionFamily applies. Not a diagnostic job. Not a giant product type.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "status",
    "slug",
    "kind",
    "stem",
    "implies",
    "conflicts"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^TRAIT-[0-9]{4}$" },
    "schema_version": { "type": "string", "const": "trait-0.1" },
    "status": { "type": "string", "enum": ["canonical"] },
    "slug": { "type": "string", "minLength": 3, "pattern": "^[a-z][a-z0-9_]*$" },
    "kind": {
      "type": "string",
      "enum": ["shape", "principal", "dependency", "capability", "control_plane", "operations"]
    },
    "stem": { "type": "string", "minLength": 12 },
    "implies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "notes": { "type": "string" }
  }
}
