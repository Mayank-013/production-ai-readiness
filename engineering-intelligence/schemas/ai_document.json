    "retrieval_requirement": { "type": "array", "items": { "$ref": "evidenced_value.json" } },
    "agent_control": { "type": "array", "items": { "$ref": "evidenced_value.json" } },
    "safety_control": { "type": "array", "items": { "$ref": "evidenced_value.json" } },
    "observability_requirement": { "type": "array", "items": { "$ref": "evidenced_value.json" } },
    "cost_performance_tradeoff": { "type": "array", "items": { "$ref": "evidenced_value.json" } }
  }
}
