{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraitDetectorObservation",
  "description": "One cited detector hit. The first B2 repo run emits these from the frozen catalog. Do not attach PRESENT/LIKELY/ABSENT/UNKNOWN. Do not accept an opaque classification with no file span. location is the contracted span field. supports is copied from the detector declaration, not inferred from the detector_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detector_id",
    "observation",
    "strength",
    "supports",
    "file",
    "location"
  ],
  "properties": {
    "detector_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"
    },
    "trait": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Investigation context from the detector declaration. B3 must use supports, not this field."
    },
    "supports": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "observation": { "type": "string", "minLength": 12 },
    "strength": { "type": "string", "enum": ["strong", "weak"] },
    "file": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "end_line"],
      "properties": {
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "symbol": { "type": "string" }
  }
}
